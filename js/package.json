{
  "name": "@nyontra/sdk",
  "version": "0.1.1",
  "description": "Official Nyontra JavaScript/TypeScript SDK — local secp256k1 key management, canonical transaction signing, and an HTTP client for the api.nyontra.com gateway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nyontra",
    "ledger",
    "sdk",
    "signing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyontra/sdk.git",
    "directory": "js"
  },
  "homepage": "https://github.com/nyontra/sdk#readme",
  "bugs": {
    "url": "https://github.com/nyontra/sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "viem": "^2.57.5",
    "vitest": "^4.1.12"
  }
}
